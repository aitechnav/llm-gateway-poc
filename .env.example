# SentinelGuard Docker image published from the SentinelGuard repo.
SENTINELGUARD_IMAGE=aitechnav/sentinelguard:0.0.10

# The chatbot uses this client token to authenticate to SentinelGuard.
# For a real deployment, generate a new one with:
#   sentinelguard token
SENTINELGUARD_GATEWAY_API_KEY=sgw_local_demo_token_change_me
SENTINELGUARD_AUDIT_SALT=sgaudit_local_demo_salt_change_me

# The demo uses mock providers by default, so these can stay empty.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
MISTRAL_API_KEY=
MINIMAX_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=
OLLAMA_API_KEY=

CHAT_MODEL=sentinel-auto
GRAFANA_ADMIN_PASSWORD=sentinelguard
